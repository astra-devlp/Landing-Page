# Copy this file to .env (never commit .env) and fill in the key.
# `npm run dev` reads it. In production the same variables are set in
# Netlify: Site configuration > Environment variables.

# OpenRouter key, or the key of any OpenAI-compatible provider.
LLM_API_KEY=

# OpenAI-compatible base URL.
LLM_BASE_URL=https://openrouter.ai/api/v1
